#include "core/version.h"

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

GODOT_ICON ICON platform/windows/godot.ico
1 RT_MANIFEST "platform/windows/godot.manifest"

1 VERSIONINFO
FILEVERSION     ENGINE_VERSION_MAJOR,ENGINE_VERSION_MINOR,ENGINE_VERSION_PATCH,0
PRODUCTVERSION  ENGINE_VERSION_MAJOR,ENGINE_VERSION_MINOR,ENGINE_VERSION_PATCH,0
FILEOS          4
FILETYPE        1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",            ENGINE_VERSION_NAME
            VALUE "FileDescription",        ENGINE_VERSION_NAME
            VALUE "FileVersion",            ENGINE_VERSION_NUMBER
            VALUE "ProductName",            ENGINE_VERSION_NAME
            VALUE "Licence",                ENGINE_VERSION_LICENSE
            VALUE "LegalCopyright",         ENGINE_VERSION_COPYRIGHT
            VALUE "Info",                   ENGINE_VERSION_WEBSITE
            VALUE "ProductVersion",         ENGINE_VERSION_FULL_BUILD
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
